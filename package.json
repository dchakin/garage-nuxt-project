{
  "name": "garage",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22",
    "npm": ">=11"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @garage/api",
    "dev:web": "npm run dev -w @garage/web",
    "build": "npm run build -w @garage/api -w @garage/web",
    "build:api": "npm run build -w @garage/api",
    "build:web": "npm run build -w @garage/web",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tests/e2e",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "npm run db:generate -w @garage/api",
    "db:migrate": "npm run db:migrate -w @garage/api",
    "db:seed": "npm run db:seed -w @garage/api",
    "postinstall": "npm run postinstall --workspaces --if-present",
    "prepare": "husky || true",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "concurrently": "^9.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.2",
    "vitest": "^5.0.1"
  },
  "lint-staged": {
    "*.{ts,vue,js,mjs,json,css,yml,yaml,md}": "prettier --write"
  }
}
