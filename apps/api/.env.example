# apps/api — копировать в apps/api/.env
NUXT_SESSION_PASSWORD=change-me-to-a-random-32-char-string
DB_FILE_NAME=server/database/garage.db
# Web Push: сгенерировать пару ключей командой `npx web-push generate-vapid-keys`
NUXT_PUBLIC_VAPID_PUBLIC_KEY=
NUXT_VAPID_PRIVATE_KEY=
NUXT_VAPID_SUBJECT=mailto:you@example.com
# Почта (сброс пароля): без SMTP и outbox выключена
NUXT_SMTP_URL=
NUXT_MAIL_FROM=Гараж <no-reply@example.com>
# База ссылок в письмах
NUXT_APP_URL=http://localhost:3000
# Вместо SMTP писать письма JSON-файлами в каталог (тесты, e2e)
NUXT_MAIL_OUTBOX_DIR=
# Доп. origin'ы для CORS через запятую (origin'ы Capacitor разрешены всегда)
NUXT_CORS_ORIGINS=
# Каталог со сборкой apps/web (apps/web/.output/public) — тогда API раздаёт и клиент. В dev не нужен.
NUXT_WEB_DIST_DIR=
