{
  "name": "@garage/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nitropack dev --port 3001",
    "build": "nitropack build",
    "preview": "node .output/server/index.mjs",
    "postinstall": "nitropack prepare",
    "typecheck": "nitropack prepare && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/database/migrate.ts",
    "db:seed": "tsx server/database/seed.ts"
  },
  "dependencies": {
    "@adonisjs/hash": "^9.1.1",
    "@garage/shared": "*",
    "better-sqlite3": "^11.7.0",
    "drizzle-orm": "^0.38.3",
    "jose": "^6.2.3",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.30.1",
    "h3": "^1.15.0",
    "ofetch": "^1.4.1",
    "nitropack": "^2.13.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
