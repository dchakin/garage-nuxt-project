# apps/web — копировать в apps/web/.env (всё необязательно)
# Куда dev-сервер проксирует /api (по умолчанию http://127.0.0.1:3001/api)
NUXT_API_PROXY_TARGET=
# Базовый URL API; для веба пусто (тот же origin), для мобильной сборки — адрес прода
NUXT_PUBLIC_API_BASE=
# cookie (веб) | token (мобильный клиент)
NUXT_PUBLIC_AUTH_MODE=cookie
