              "name": "Rule",
              "fill": "$text-2",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "•  Цвет иконки = цвет соседнего текста (text / text-2 / accent-text). Цветные иконки — только в плитке типа записи и в статусах.",
              "lineHeight": 1.5,
              "fontFamily": "$font-sans",
