              "fill": "$accent-text",
              "content": "02 · ТИПОГРАФИКА",
              "fontFamily": "$font-sans",
              "fontSize": 13,
              "fontWeight": "600",
              "letterSpacing": 1.5
            },
            {
              "type": "text",
              "id": "U265M",
              "name": "Title",
              "fill": "$text",
              "content": "Onest + JetBrains Mono",
              "fontFamily": "$font-sans",
              "fontSize": 48,
              "fontWeight": "700",
              "letterSpacing": -1
            },
            {
              "type": "text",
              "id": "MxDJz",
              "name": "Lead",
              "fill": "$text-2",
              "textGrowth": "fixed-width",
              "width": 1100,
              "content": "Onest — современный гротеск, сделанный под кириллицу (а не «дорисованный» к латинице): открытые формы, хорошо читается на 11–14 px на улице и в перчатках, есть 9 начертаний и табличные цифры — суммы и пробег не «прыгают» при изменении. JetBrains Mono — только для госномера и VIN, чтобы символы не путались (0/О, В/8).",
              "lineHeight": 1.5,
              "fontFamily": "$font-sans",
              "fontSize": 18,
              "fontWeight": "normal"
            }
          ]
